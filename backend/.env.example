# MAVLink connection string for the backend to listen on. sim_vehicle.py
# should be launched with a matching --out=udp:127.0.0.1:14560
MAVLINK_CONNECTION=udpin:127.0.0.1:14560

REDIS_URL=redis://localhost:6379/0

# Origin allowed for browser -> backend calls when not using the Vite proxy
CORS_ORIGIN=http://localhost:5173

# Seconds without a heartbeat before the vehicle is considered disconnected
HEARTBEAT_TIMEOUT_SECONDS=5

# Timeout waiting for a MAVLink COMMAND_ACK
COMMAND_ACK_TIMEOUT_SECONDS=5
